{
  "expo": {
    "name": "guitar-note-atlas",
    "slug": "guitar-note-atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "dev.com.guitar-note-atlas",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "dev.com.guitarnoteatlas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-screen-orientation",
      "./plugins/withAndroidImmersiveMode",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E69AF",
          "image": "./assets/splash.png"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": true
        }
      ],
      "expo-audio",
      "expo-asset"
    ]
  }
}
